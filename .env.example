# 复制成 .env 并按需修改，start-*.sh 会自动加载

# Ollama 地址，保持默认即可（它只监听本地）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 网关监听端口，同事的程序调这个
OCR_HUB_PORT=8000
OCR_HUB_BIND=0.0.0.0

# 并发上限，要和 OLLAMA_NUM_PARALLEL 保持一致
OCR_HUB_PARALLEL=2

# 单次请求超时（秒）
OCR_HUB_TIMEOUT=600

# 面板上展示的调用示例用哪个地址。留空则自动探测本机局域网 IP
OCR_HUB_HOST=192.168.55.10

# 示例代码里默认写哪个模型
OCR_HUB_DEFAULT_MODEL=deepseek-ocr

# 是否剥掉模型漏出来的特殊 token（<|im_end|>、<|md_start|>、<|ref|> 等）
# 默认开启。设为 0 则原样透传，由调用方自己处理
OCR_HUB_STRIP_TOKENS=1

# 仅当网关前面有可信反向代理、由它写入 X-Forwarded-For 时才开启
OCR_HUB_TRUST_PROXY_HEADERS=0

# macOS 原生指标服务。保持回环监听，不对局域网直接开放
OCR_HUB_METRICS_BIND=127.0.0.1
OCR_HUB_METRICS_PORT=9105

# Mac 原生面板入口。它保留访问设备真实 IP，再转给 127.0.0.1:8502 的容器。
OCR_HUB_PANEL_BIND=0.0.0.0
OCR_HUB_PANEL_PORT=8501
OCR_HUB_PANEL_UPSTREAM=http://127.0.0.1:8502

# 管理功能口令。不设置则面板里的管理区块不可用
OCR_HUB_ADMIN_PASSWORD=
